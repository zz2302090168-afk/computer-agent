# Copy values into ignored .env.local; never put real credentials in this template.
DATABASE_URL=mysql://pc_advisor:change-me@localhost:3306/pc_advisor
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Optional server-side Jev credentials; do not replace MODEL_*.
# Fill the key locally in .env.local. Never use NEXT_PUBLIC_ for credentials.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional narrow read-only entry routing; false keeps the original workflow.
JEV_ROUTER_ENABLED=false
# Separate experiment: Jev selects tools; the main model still supplies arguments.
JEV_TOOL_SELECTOR_ENABLED=false
# Requirements-only semantic acceptance; initial thresholds, not business-calibrated.
JEV_REQUIREMENT_CONFIDENCE=0.8
JEV_REQUIREMENT_PROBABILITY=0.9
