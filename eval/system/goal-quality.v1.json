          "expect": "explain_selection",
          "preserve": true,
          "semanticReview": true,
          "selectionUnchanged": true
        }
      ]
    },
    {
      "id": "COORD03",
      "group": "多对象否定",
      "initial": "unselected",
      "turns": [
        {
          "query": "不要第一套，选择第二套继续讨论，不确认购买。",
          "expect": "select",
          "expectedPlanIndex": 1,
          "preserve": true
        }
      ]
    },
    {
      "id": "COORD04",
      "group": "无效对象否定",
      "initial": "unselected",
      "turns": [
        {
          "query": "不要选第二套，只选第99套。不存在就告诉我，不要改选。",
          "expect": "consult",
          "preserve": true,
          "selectionUnchanged": true
        }
      ]
    },
    {
      "id": "PRICE01",
      "group": "严格降价",
      "initial": "selected",
      "turns": [
        {
          "query": "只看看当前方案显卡能换什么更便宜的，必须比现在的显卡单价低，同价或更贵都不要，先不要换。",
          "expect": "find_replacements",
          "preserve": true,
          "strictCheaper": true,
          "minReplacementCandidates": 1
        }
      ]
    },
    {
      "id": "PRICE02",
      "group": "严格降价",
      "initial": "unselected",
      "turns": [
        {
          "query": "先选第二套作为讨论对象，不确认购买，然后只查询这套显卡能换哪些更便宜的，先不执行替换。",
          "expect": "find_replacements",
          "preserve": true,
          "strictCheaper": true,
          "minReplacementCandidates": 1,
          "expectedPlanIndex": 1
        }
      ]
    },
    {
      "id": "PRICE03",
      "group": "严格降价",
      "initial": "selected",
