          "expect": "find_replacements",
          "preserve": true,
          "minReplacementCandidates": 1,
          "requireNonCheaperCandidate": true
        }
      ]
    },
    {
      "id": "PRICE05",
      "group": "严格降价",
      "initial": "selected",
      "turns": [
        {
          "query": "只查询显卡和硬盘一起换的候选，其他六件不动，要求两件合计比原来的合计便宜；单件可以涨价，只看整套降价，先不执行。",
          "expect": "find_replacements",
          "preserve": true,
          "strictCheaper": true,
          "minReplacementCandidates": 1
        }
      ]
    },
    {
      "id": "PRICE06",
      "group": "严格降价",
      "initial": "selected",
      "turns": [
        {
          "query": "只查当前CPU能否换成更便宜的AMD Ryzen 7 9700X，必须完全是这个型号，没有就如实说没有，不要换其他型号或实际替换。",
          "expect": "find_replacements",
          "preserve": true,
          "strictCheaper": true,
          "noReplacementCandidates": true
        }
      ]
    }
  ],
  "reviewRules": {
    "invalidSelection": "Reject nonexistent ordinal without listing unlabeled demo products; preserve full selection state",
    "cheaper": "Strictly lower combined replacement catalog cost; no equal/higher candidates; all IDs and differences independently checked",
    "scope": "Program oracle separate from full-answer semantic review; retain failures"
  }
