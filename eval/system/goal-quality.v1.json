          "expect": "select",
          "expectedPlanIndex": 1
        },
        {
          "query": "现在明确确认刚才选定的整套主机。",
          "expect": "confirm"
        }
      ]
    },
    {
      "id": "QUEUE01",
      "group": "自由问答边界",
