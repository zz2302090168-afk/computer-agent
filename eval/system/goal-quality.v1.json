      "turns": [
        {
          "query": "先选第二套继续讨论，不确认购买。再告诉我刷新页面以后还能找回今天的对话和方案吗？",
          "expect": "select",
          "expectedPlanIndex": 1,
          "preserve": true,
          "semanticReview": true
        }
      ]
    },
    {
      "id": "QUEUE02",
      "group": "失败边界",
      "initial": "unselected",
      "turns": [
        {
          "query": "只选择第99套方案，不要替我改选其他方案，也不要重新生成。",
          "expect": "consult",
          "preserve": true,
          "semanticReview": true,
          "selectionUnchanged": true
        }
      ]
    },
    {
      "id": "QUEUE03",
      "group": "否定边界",
      "initial": "unselected",
