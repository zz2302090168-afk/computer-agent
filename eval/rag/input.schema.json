{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RagCaseV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "split",
    "type",
    "category",
    "query",
    "relevantIds",
    "reference",
    "mustStop"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "split": { "enum": ["dev", "test"] },
    "type": { "type": "string" },
    "category": { "enum": ["sales", "support"] },
    "topicId": { "type": "string" },
    "query": { "type": "string", "minLength": 1 },
    "relevantIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "reference": { "type": "string", "minLength": 1 },
    "mustStop": { "type": "boolean" }
  }
}
